# =============================================================================
# Variables consumed by docker-compose.yml
# Copy to '.env' in the project root, then run: docker compose up --build
# (backend/.env is still required separately — see backend/.env.example
#  for SECRET_KEY, MISTRAL_API_KEY, SMTP settings, etc.)
# =============================================================================

MYSQL_ROOT_PASSWORD=kintsugi_root
MYSQL_DB=kintsugi_db
MYSQL_USER=kintsugi
MYSQL_PASSWORD=kintsugi_pw

# Used as build args for the web image (baked in at build time)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws
